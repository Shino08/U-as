@layer base {
  * { border-color: var(--color-border); }
  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-body);
    letter-spacing: 0;
    scroll-behavior: smooth;
  }
}

@keyframes rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
@keyframes float-soft { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
@utility animate-rise { animation: rise 0.8s cubic-bezier(.22, 1, .36, 1) both; }
@utility animate-float-soft { animation: float-soft 5s ease-in-out infinite; }
@keyframes strip-slide { from { transform: translateX(0); } to { transform: translateX(6px); } }
@keyframes hero-rise { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
@utility animate-hero-rise { animation: hero-rise 1s cubic-bezier(0.16, 1, 0.3, 1) both; }

/* Custom luxury scrollbar for dashboard & application */
::-webkit-scrollbar { width: 7px; height: 7px; }
::-webkit-scrollbar-track { background: transparent; }
.dark ::-webkit-scrollbar-track, [data-theme="dark"] ::-webkit-scrollbar-track { background: #0d040e; }
.light ::-webkit-scrollbar-track, [data-theme="light"] ::-webkit-scrollbar-track { background: #faf2f6; }
.dark ::-webkit-scrollbar-thumb, [data-theme="dark"] ::-webkit-scrollbar-thumb { background: #2e1131; border-radius: 9999px; border: 1.5px solid #0d040e; }
.dark ::-webkit-scrollbar-thumb:hover, [data-theme="dark"] ::-webkit-scrollbar-thumb:hover { background: #d9487d; border-color: #0d040e; }
.light ::-webkit-scrollbar-thumb, [data-theme="light"] ::-webkit-scrollbar-thumb { background: #dfb8cf; border-radius: 9999px; border: 1.5px solid #faf2f6; }
.light ::-webkit-scrollbar-thumb:hover, [data-theme="light"] ::-webkit-scrollbar-thumb:hover { background: #d9487d; border-color: #faf2f6; }
* { scrollbar-width: thin; }
.dark, [data-theme="dark"] { scrollbar-color: #38143c #0d040e; }
.light, [data-theme="light"] { scrollbar-color: #dfb8cf #faf2f6; }

/* Hero Spotlight Reveal Effect */
.hero-spotlight { cursor: none; }
.hero-spotlight .reveal-layer {
  opacity: 0;
  -webkit-mask-image: radial-gradient(circle var(--r, 200px) at var(--x) var(--y), #000 0%, #000 60%, transparent 100%);
  mask-image: radial-gradient(circle var(--r, 200px) at var(--x) var(--y), #000 0%, #000 60%, transparent 100%);
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
  transition: --x 0.12s ease-out, --y 0.12s ease-out, opacity 0.15s ease-out;
}
.hero-spotlight:hover .reveal-layer { opacity: 1; }
.hero-spotlight .reveal-layer.is-leaving { transition: opacity 0.15s ease-out; }

@property --x {
  syntax: "<length>";
  inherits: true;
  initial-value: -9999px;
}
@property --y {
  syntax: "<length>";
  inherits: true;
  initial-value: -9999px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
  .hero-spotlight .reveal-layer {
    transition: none !important;
  }
}
