              <p className={`text-sm font-semibold ${isDark ? "text-white" : "text-[#1e0a1d]"}`}>No se encontraron servicios</p>
              <p className={`text-xs mt-1 ${isDark ? "text-[#a88ea4]" : "text-[#765a71]"}`}>Prueba con otro término de búsqueda o categoría</p>
            </div>
