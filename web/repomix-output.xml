        className={`mt-4 h-8 w-16 rounded ${isDark ? "bg-[#200b22]" : "bg-gray-100"}`}
      />
    </div>
  );
}

export default function DashboardHome() {
  const { theme } = useTheme();
  const isDark = theme === "dark";

  const [stats, setStats] = useState<Stats>({
    totalAppointments: 0,
    pendingAppointments: 0,
    totalServices: 0,
    activeServices: 0,
  });
